{ "type": "Feature", "properties": { "full_id": "n3515113872", "osm_id": "3515113872", "osm_type": "node", "tourism": "museum", "contact:vk": null, "subject:wikipedia": "ru:Козлов, Пётр Кузьмич", "subject:wikidata": "Q1377678", "museum": "person", "wikipedia": null, "name:ar": null, "image": null, "fee": null, "website": null, "phone": null, "reservation": null, "operator": null, "opening_hours": null, "email": null, "name:ru": "Музей-квартира П. К. Козлова", "name:en": "P.K. Kozlov Memorial Museum", "full_name:ru": "Институт истории естествознания и техники им. С.И. Вавилова Российской академии наук (Санкт-Петербургский филиал). Мемориальный музей-квартира П.К. Козлова", "full_name:en": "P.K. Kozlov Memorial Museum at the Institute for the History of Science & Technology at the Russian Academy of Sciences (Saint Petersburg Branch)", "full_name": "Институт истории естествознания и техники им. С.И. Вавилова Российской академии наук (Санкт-Петербургский филиал). Мемориальный музей-квартира П.К. Козлова", "description:ru": "Среди экспонируемых предметов – архивные документы, дневники, письма, книги, географические карты, рисунки и фотографии, личные вещи П.К. Козлова, свидетельствующие о великой эпохе научного освоения Россией центральноазиатского региона.", "description:en": "The items on display in the museum are mainly the things Kozlov used during his travels, such as wooden trunks, leather bags, various measuring instruments, binoculars, a medical chest, a toilet-case, etc.", "description": "Среди экспонируемых предметов – архивные документы, дневники, письма, книги, географические карты, рисунки и фотографии, личные вещи П.К. Козлова, свидетельствующие о великой эпохе научного освоения Россией центральноазиатского региона.", "contact:website": "http://kozlovmuseum.org/", "contact:phone": "+7 812 7100350;+7 812 5771243", "contact:fax": null, "contact:email": "kozlov.museum@mail.ru", "wikidata": null, "name:ca": null, "name": "Музей-квартира П. К. Козлова", "histor